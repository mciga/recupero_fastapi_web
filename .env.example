# Copia in ".env" per avviare l'API in locale.
# Online (Render) si usa invece DATABASE_URL con la stringa di connessione di Neon.

PGHOST=localhost
PGPORT=5432
PGDATABASE=recupero_materie
PGUSER=recupero_user
PGPASSWORD=recupero_pass
PGSCHEMA=recupero_novembre

# password di accesso alla dashboard (se vuota la dashboard e' libera)
# APP_PASSWORD=
# APP_USER=mactee
